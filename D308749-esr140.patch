diff --git a/dom/media/webcodecs/crashtests/2045057.html b/dom/media/webcodecs/crashtests/2045057.html
new file mode 100644
index 0000000000..9103dfab2a
--- /dev/null
+++ b/dom/media/webcodecs/crashtests/2045057.html
@@ -0,0 +1,33 @@
+<!DOCTYPE html>
+<html class="reftest-wait">
+<head><meta charset="utf-8"></head>
+<body>
+<video id="v" muted playsinline></video>
+<script>
+const M="";
+const v = document.getElementById("v");
+const bin = atob(M), u = new Uint8Array(bin.length);
+for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);
+v.src = URL.createObjectURL(new Blob([u], { type: "video/mp4" }));
+
+async function run() {
+  if (typeof VideoFrame === "undefined") { return; }
+  await new Promise(resolve => {
+    v.addEventListener("loadeddata", resolve, { once: true });
+    v.load();
+  });
+  let f;
+  try { f = new VideoFrame(v); } catch (e) { return; }
+  try {
+    const n = f.allocationSize();
+    await f.copyTo(new ArrayBuffer(n));
+  } catch (e) {
+  } finally {
+    try { f.close(); } catch (e) {}
+  }
+}
+
+run().finally(() => { document.documentElement.className = ""; });
+</script>
+</body>
+</html>
